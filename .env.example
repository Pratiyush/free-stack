# Copy this file to .env (which is .gitignore'd) and fill in the values you need.
# All PUBLIC_* vars are inlined into the client bundle at build time — don't put
# secrets here, only public tokens.

# Cloudflare Web Analytics — opt-in, no cookies, no PII. Get a token at:
#   https://dash.cloudflare.com/?to=/:account/web-analytics
# Leave empty in local dev; CI sets this on the production build only.
PUBLIC_CF_ANALYTICS_TOKEN=
