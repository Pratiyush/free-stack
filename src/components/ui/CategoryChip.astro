---
interface Props {
  slug: string;
  name: string;
  count?: number;
  href?: string;
  size?: 'sm' | 'md';
}

const { slug, name, count, href, size = 'md' } = Astro.props;
const tag = href ? 'a' : 'span';
const url = href ?? `/category/${slug}`;
---

{
  tag === 'a' ? (
    <a class:list={['category-chip', `size-${size}`]} href={url} data-slug={slug}>
      <span class="chip-name">{name}</span>
      {count !== undefined && <span class="chip-count">{count}</span>}
    </a>
  ) : (
    <span class:list={['category-chip', `size-${size}`]} data-slug={slug}>
      <span class="chip-name">{name}</span>
      {count !== undefined && <span class="chip-count">{count}</span>}
    </span>
  )
}

<style>
  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 0.88rem;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  a.category-chip:hover {
    border-color: var(--color-ink);
    background: var(--color-paper-deep);
  }
  .size-sm {
    font-size: 0.78rem;
    padding: 0.2rem 0.55rem;
  }
  .chip-name {
    font-weight: 500;
  }
  .chip-count {
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
</style>
