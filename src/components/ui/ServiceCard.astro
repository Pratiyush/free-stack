---
import TierBadge from './TierBadge.astro';
import type { CollectionEntry } from 'astro:content';
import { FALLBACK_BRAND_COLOR } from '~/lib/theme';
import { u } from '~/lib/url';

interface Props {
  service: CollectionEntry<'services'>;
  categoryName?: string;
  variant?: 'default' | 'compact';
}

const { service, categoryName, variant = 'default' } = Astro.props;
const { name, slug, summary, brand_color, logo, tier_type, free_tier, category, facets } =
  service.data;
const accent = brand_color ?? FALLBACK_BRAND_COLOR;
const ccRequired = facets?.cc_required === true;
---

<article
  class:list={['service-card', `variant-${variant}`]}
  style={`--card-accent: ${accent};`}
  data-slug={slug}
  data-tier={tier_type}
  data-category={category}
  transition:name={`card-${slug}`}
>
  <span class="head-band" aria-hidden="true"></span>

  <header class="hero-zone">
    <div class="logo-frame" aria-hidden="true">
      <img src={u(logo)} alt="" loading="lazy" width="32" height="32" />
    </div>
    <div class="title-wrap">
      <h3 class="card-name">
        <a href={`/service/${slug}`}>{name}</a>
      </h3>
      {categoryName && <p class="card-category">{categoryName}</p>}
    </div>
  </header>

  <p class="card-summary">{summary}</p>

  {
    variant === 'default' && free_tier.length > 0 && (
      <ul class="free-tier-bullets">
        {free_tier.slice(0, 3).map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )
  }

  <footer class="card-footer">
    <div class="badge-row">
      <TierBadge tier={tier_type} size="sm" />
      {
        ccRequired && (
          <span class="cc-pill" title="Credit card required to sign up">
            CC req
          </span>
        )
      }
    </div>
    <a class="detail-link" href={`/service/${slug}`}>Details →</a>
  </footer>
</article>

<style>
  .service-card {
    --card-accent-effective: var(--card-accent);
    --card-accent-tint: color-mix(in srgb, var(--card-accent) 9%, var(--color-paper-warm));

    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: 0;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.18s ease;

    /* v4.0 perf — skip rendering off-screen cards. Reserves ~440px so layout
       doesn't jump while scrolling. Brings catalog Lighthouse perf from ~91
       to 98+ on mobile by drastically reducing initial paint cost. */
    content-visibility: auto;
    contain-intrinsic-size: 0 440px;
  }

  .service-card:hover {
    border-color: var(--card-accent);
  }

  .service-card:focus-within {
    outline: 2px solid var(--color-coral);
    outline-offset: 2px;
  }

  /* Top head-band — 4px full-width brand accent.
     Replaces the v0.2.0 left-side strip. */
  .head-band {
    display: block;
    height: 4px;
    width: 100%;
    background: var(--card-accent);
  }

  /* Tinted hero zone — logo + name + category sit on a 9% brand-color wash. */
  .hero-zone {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
    align-items: center;
    padding: var(--space-md);
    background: var(--card-accent-tint);
    border-bottom: 1px solid var(--color-rule);
  }

  .logo-frame {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .logo-frame img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }

  .title-wrap {
    min-width: 0;
  }
  .card-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.005em;
  }
  .card-name a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .card-name a:hover {
    color: var(--card-accent);
  }
  .card-category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0.2rem 0 0;
  }

  .card-summary {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    padding: 0 var(--space-md);
    margin: var(--space-sm) 0 0;
    min-height: 2.6em; /* keep keyfact alignment across the grid */
  }

  /* Hanging em-dash bullets — editorial almanac voice over checkmark list. */
  .free-tier-bullets {
    list-style: none;
    padding: 0 var(--space-md);
    margin: var(--space-xs) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.86rem;
  }
  .free-tier-bullets li {
    color: var(--color-ink);
    padding-left: 1.4em;
    text-indent: -1.4em;
    line-height: 1.45;
  }
  .free-tier-bullets li::before {
    content: '—  ';
    color: var(--card-accent);
    font-weight: 500;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md) var(--space-md);
    margin-top: auto;
  }
  .badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }
  .cc-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.18rem 0.4rem;
    color: var(--color-coral);
    border: 1px solid var(--color-coral);
    border-radius: var(--radius-sm);
    background: transparent;
  }
  .detail-link {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .detail-link:hover {
    color: var(--card-accent);
  }

  /* Compact variant — recently-verified strip, etc. */
  .variant-compact .card-summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .variant-compact .free-tier-bullets {
    display: none;
  }
</style>
