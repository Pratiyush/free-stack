---
import TierBadge from './TierBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
  categoryName?: string;
  variant?: 'default' | 'compact';
}

const { service, categoryName, variant = 'default' } = Astro.props;
const { name, slug, summary, brand_color, logo, tier_type, free_tier, category } = service.data;
const accent = brand_color ?? '#1a1a1a';
---

<article
  class:list={['service-card', `variant-${variant}`]}
  style={`--card-accent: ${accent};`}
  data-slug={slug}
  data-tier={tier_type}
  data-category={category}
>
  <span class="accent-bar" aria-hidden="true"></span>

  <header class="card-header">
    <div class="logo-wrap" aria-hidden="true">
      <img src={logo} alt="" loading="lazy" width="36" height="36" />
    </div>
    <div class="title-wrap">
      <h3 class="card-name">
        <a href={`/service/${slug}`}>{name}</a>
      </h3>
      {categoryName && <p class="card-category">{categoryName}</p>}
    </div>
    <TierBadge tier={tier_type} size="sm" />
  </header>

  <p class="card-summary">{summary}</p>

  {
    variant === 'default' && free_tier.length > 0 && (
      <ul class="free-tier-bullets">
        {free_tier.slice(0, 3).map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )
  }

  <footer class="card-footer">
    <a class="detail-link" href={`/service/${slug}`}>Details →</a>
  </footer>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    padding-left: calc(var(--space-md) + 6px);
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .service-card:hover {
    border-color: var(--card-accent);
    transform: translateY(-1px);
  }
  .accent-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--card-accent);
    border-radius: var(--radius-md) 0 0 var(--radius-md);
  }
  .card-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-sm);
    align-items: center;
  }
  .logo-wrap {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--card-accent) 8%, transparent);
  }
  .logo-wrap img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  .title-wrap {
    min-width: 0;
  }
  .card-name {
    font-size: 1.1rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.2;
  }
  .card-name a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .card-name a:hover {
    color: var(--card-accent);
  }
  .card-category {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }
  .card-summary {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.5;
    max-width: 100%;
  }
  .free-tier-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.86rem;
  }
  .free-tier-bullets li {
    color: var(--color-ink);
    padding-left: 1rem;
    position: relative;
  }
  .free-tier-bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--card-accent);
    font-weight: 500;
  }
  .card-footer {
    margin-top: auto;
    padding-top: var(--space-xs);
  }
  .detail-link {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  .detail-link:hover {
    color: var(--card-accent);
  }
  .variant-compact {
    padding: var(--space-sm);
  }
  .variant-compact .card-summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
