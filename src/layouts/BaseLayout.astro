---
import '~/styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = '319 verified free tiers for developers across 27 categories. No ads, no affiliate links.',
  canonical = Astro.url.href,
} = Astro.props;

const fullTitle = title === 'free-stack' ? title : `${title} — free-stack`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="free-stack — recently verified free tiers"
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">∗</span>
          <span class="brand-name">free-stack</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/catalog">Catalog</a>
          <a href="/methodology">Methodology</a>
          <a href="/submit">Submit</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <hr />
        <div class="footer-grid">
          <div>
            <p class="footer-tagline">
              <strong>free-stack</strong> — verified free tiers for developers. No ads. No affiliate links.
              Sponsorship covers domain + hosting only.
            </p>
          </div>
          <nav aria-label="Footer">
            <a href="/sponsors">Sponsors</a>
            <a href="/methodology">Methodology</a>
            <a href="/changelog">Changelog</a>
            <a href="https://github.com/Pratiyush/free-stack" rel="noopener noreferrer">GitHub</a>
          </nav>
        </div>
        <p class="footer-fineprint">
          FreeStack is not affiliated with, endorsed by, or sponsored by any listed service. All
          trademarks are property of their respective owners. Removal requests:
          <a href="mailto:removals@freestack.is-a.dev">removals@freestack.is-a.dev</a>.
        </p>
        <p class="footer-credit">
          Made with care by <a href="https://github.com/Pratiyush" rel="noopener noreferrer"
            >Pratiyush</a
          >. Source on <a href="https://github.com/Pratiyush/free-stack" rel="noopener noreferrer"
            >GitHub</a
          >.
        </p>
      </div>
    </footer>

    <style is:global>
      .site-header {
        border-bottom: var(--border-rule);
        padding: var(--space-md) 0;
        background: var(--color-paper);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
      }
      .brand {
        display: inline-flex;
        align-items: baseline;
        gap: 0.4rem;
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 1.5rem;
        color: var(--color-ink);
      }
      .brand-mark {
        color: var(--color-coral);
        font-size: 1.5rem;
        line-height: 1;
      }
      .brand-name {
        font-weight: 500;
        letter-spacing: -0.01em;
      }
      .site-nav {
        display: flex;
        gap: var(--space-lg);
        font-size: 0.95rem;
      }
      .site-nav a {
        text-decoration: none;
        color: var(--color-ink-soft);
        transition: color 0.15s ease;
      }
      .site-nav a:hover {
        color: var(--color-ink);
      }
      main {
        min-height: 60vh;
      }
      .site-footer {
        margin-top: var(--space-2xl);
        padding-bottom: var(--space-2xl);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--space-lg);
        align-items: center;
        margin-bottom: var(--space-md);
      }
      .footer-tagline {
        font-size: 0.95rem;
        color: var(--color-ink-soft);
        max-width: 56ch;
      }
      .site-footer nav {
        display: flex;
        gap: var(--space-md);
        font-size: 0.9rem;
      }
      .site-footer nav a {
        color: var(--color-ink-soft);
        text-decoration: none;
      }
      .site-footer nav a:hover {
        color: var(--color-ink);
      }
      .footer-fineprint,
      .footer-credit {
        font-size: 0.82rem;
        color: var(--color-ink-soft);
        margin-top: var(--space-sm);
      }
      .footer-credit {
        color: var(--color-ink-soft);
        opacity: 0.8;
      }
      @media (max-width: 640px) {
        .header-inner {
          flex-direction: column;
          align-items: flex-start;
        }
        .footer-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
