---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SponsorMeter from '~/components/ui/SponsorMeter.astro';
import { u } from '~/lib/url';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = '300 verified free tiers for developers across 27 categories. No ads, no affiliate links.',
  canonical: canonicalProp,
  ogImage = '/og/default.png',
  ogType = 'website',
} = Astro.props;

const fullTitle = title === 'opentier' ? title : `${title} — opentier`;
const siteUrl = 'https://opentier.dev';

// v3.0 review F2+F3 — canonical and absoluteOgImage point at the APEX domain
// without the Pages base prefix. Astro.url.href includes the base (`/opentier/...`),
// so strip it; we want consumers (search engines, social cards) to discover the
// final opentier.dev URL, not the temporary GH Pages subpath.
const baseStripped = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const pathForCanonical = (Astro.url.pathname || '/').replace(baseStripped, '') || '/';
const canonical = canonicalProp ?? `${siteUrl}${pathForCanonical}`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// 5.12 Opt-in Cloudflare Web Analytics. No cookies, no PII. Set the token in
// the deploy environment as PUBLIC_CF_ANALYTICS_TOKEN to enable. Local dev and
// non-production builds skip the beacon entirely.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /* v3.0 review F5 — minimal CSP. Allows self + the CF Web Analytics beacon
        (env-gated; if PUBLIC_CF_ANALYTICS_TOKEN unset, the script doesn't render).
        Inline styles + inline scripts allowed because Astro inlines critical CSS
        and JSON-LD blocks. img-src allows the per-service OG cards. data: for
        favicon. Tightens supply-chain trust without breaking the build. */
    }
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://opentier.dev; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:site_name" content="opentier" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="opentier — recently verified free tiers"
      href={u('/rss.xml')}
    />

    {/* Mobile chrome theme color matches the paper-warm background. */}
    <meta name="theme-color" content="#fdfaf2" />
    <meta name="color-scheme" content="light" />

    {
      /* Story 5.1c — preload the two LCP fonts so the browser starts fetching
        during HTML parse, not after CSS resolves. Italic loads progressively. */
    }
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={u('/fonts/fraunces-latin-wght-normal.woff2')}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={u('/fonts/inter-tight-latin-wght-normal.woff2')}
      crossorigin
    />

    {
      /* Story 5.1c — inline @font-face for critical latin subset. Loaded BEFORE
        Fontsource's bundle (which @imports in global.css) so the browser uses
        our preloaded /fonts/*.woff2 for latin glyphs. */
    }
    <style
      is:inline
      set:html={`
      @font-face {
        font-family: 'Fraunces Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url('${u('/fonts/fraunces-latin-wght-normal.woff2')}') format('woff2-variations');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Fraunces Variable';
        font-style: italic;
        font-display: swap;
        font-weight: 100 900;
        src: url('${u('/fonts/fraunces-latin-wght-italic.woff2')}') format('woff2-variations');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter Tight Variable';
        font-style: normal;
        font-display: swap;
        font-weight: 100 900;
        src: url('${u('/fonts/inter-tight-latin-wght-normal.woff2')}') format('woff2-variations');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    `}
    ></style>

    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    {
      cfAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <span class="brand-mark">∗</span>
          <span class="brand-name">opentier</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/catalog">Catalog</a>
          <a href="/methodology">Methodology</a>
          <a href="/submit">Submit</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <hr />
        <div class="footer-grid">
          <div>
            <p class="footer-tagline">
              <strong>opentier</strong> — verified free tiers for developers. No ads. No affiliate links.
              Sponsorship covers domain + hosting only.
            </p>
          </div>
          <nav aria-label="Footer">
            <SponsorMeter variant="footer" />
            <a href="/methodology">Methodology</a>
            <a href="/legal">Legal</a>
            <a href="/changelog">Changelog</a>
            <a href="https://github.com/Pratiyush/opentier" rel="noopener noreferrer">GitHub</a>
          </nav>
        </div>
        <p class="footer-fineprint">
          opentier is not affiliated with, endorsed by, or sponsored by any listed service. All
          trademarks are property of their respective owners. Removal requests:
          <a href="mailto:removals@opentier.dev">removals@opentier.dev</a>.
        </p>
        <p class="footer-credit">
          Made with care by <a href="https://github.com/Pratiyush" rel="noopener noreferrer"
            >Pratiyush</a
          >. Source on <a href="https://github.com/Pratiyush/opentier" rel="noopener noreferrer"
            >GitHub</a
          >.
        </p>
      </div>
    </footer>

    <style is:global>
      /* Skip-to-main link — visible on keyboard focus only. WCAG 2.4.1 bypass. */
      .skip-link {
        position: absolute;
        top: 0;
        left: 0;
        padding: 0.6rem 1rem;
        background: var(--color-ink);
        color: var(--color-paper);
        text-decoration: none;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        z-index: 100;
        transform: translateY(-100%);
        transition: transform 0.18s ease;
      }
      .skip-link:focus {
        transform: translateY(0);
        outline: 2px solid var(--color-coral-accent);
        outline-offset: 2px;
      }
      .site-header {
        border-bottom: var(--border-rule);
        padding: var(--space-md) 0;
        background: var(--color-paper);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
      }
      .brand {
        display: inline-flex;
        align-items: baseline;
        gap: 0.4rem;
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 1.5rem;
        color: var(--color-ink);
      }
      .brand-mark {
        color: var(--color-coral);
        font-size: 1.5rem;
        line-height: 1;
      }
      .brand-name {
        font-weight: 500;
        letter-spacing: -0.01em;
      }
      .site-nav {
        display: flex;
        gap: var(--space-lg);
        font-size: 0.95rem;
      }
      .site-nav a {
        text-decoration: none;
        color: var(--color-ink-soft);
        transition: color 0.15s ease;
      }
      .site-nav a:hover,
      .site-nav a:focus-visible {
        color: var(--color-ink);
        outline: 2px solid var(--color-coral);
        outline-offset: 4px;
        border-radius: 2px;
      }
      main {
        min-height: 60vh;
      }
      .site-footer {
        margin-top: var(--space-2xl);
        padding-bottom: var(--space-2xl);
      }
      .footer-grid {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--space-lg);
        align-items: center;
        margin-bottom: var(--space-md);
      }
      .footer-tagline {
        font-size: 0.95rem;
        color: var(--color-ink-soft);
        max-width: 56ch;
      }
      .site-footer nav {
        display: flex;
        gap: var(--space-md);
        font-size: 0.9rem;
      }
      .site-footer nav a {
        color: var(--color-ink-soft);
        text-decoration: none;
      }
      .site-footer nav a:hover,
      .site-footer nav a:focus-visible {
        color: var(--color-ink);
        outline: 2px solid var(--color-coral);
        outline-offset: 3px;
        border-radius: 2px;
      }
      .footer-fineprint,
      .footer-credit {
        font-size: 0.82rem;
        color: var(--color-ink-soft);
        margin-top: var(--space-sm);
      }
      .footer-credit {
        color: var(--color-ink-soft);
        opacity: 0.8;
      }
      @media (max-width: 640px) {
        .header-inner {
          flex-direction: column;
          align-items: flex-start;
        }
        .footer-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
