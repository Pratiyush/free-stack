---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="The page you're looking for doesn't exist.">
  <section class="container-narrow notfound">
    <p class="eyebrow">404 · Not Found</p>
    <h1>That page isn't here.</h1>
    <p class="lede">Most likely the URL changed or never existed. Try the catalog, or head home.</p>
    <div class="cta-row">
      <a class="cta-primary" href="/catalog">Browse the catalog</a>
      <a class="cta-secondary" href="/">Home</a>
    </div>
  </section>

  <style>
    .notfound {
      padding-top: var(--space-2xl);
      padding-bottom: var(--space-2xl);
    }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-coral);
      margin-bottom: var(--space-md);
    }
    .lede {
      margin-top: var(--space-md);
      color: var(--color-ink-soft);
      font-size: 1.1rem;
    }
    .cta-row {
      display: flex;
      gap: var(--space-md);
      margin-top: var(--space-lg);
      flex-wrap: wrap;
    }
    .cta-primary,
    .cta-secondary {
      display: inline-block;
      padding: 0.7rem 1.2rem;
      border-radius: var(--radius-md);
      text-decoration: none;
      font-weight: 500;
    }
    .cta-primary {
      background: var(--color-ink);
      color: var(--color-paper);
    }
    .cta-secondary {
      background: transparent;
      color: var(--color-ink);
      border: 1px solid var(--color-rule);
    }
  </style>
</BaseLayout>
