---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import TierBadge from '~/components/ui/TierBadge.astro';
import { FALLBACK_BRAND_COLOR } from '~/lib/theme';
import { u } from '~/lib/url';

type ServiceEntry = CollectionEntry<'services'>;
type PricingTier = ServiceEntry['data']['pricing'][number];
type Sources = NonNullable<ServiceEntry['data']['sources']>;

export async function getStaticPaths() {
  const services = await getCollection('services');

  // Compute a per-category serial number: services within each category sorted
  // by date_added ascending get № 001, 002, etc. Stable, editorial-feeling identifier.
  const byCategory: Record<string, typeof services> = {};
  for (const s of services) {
    (byCategory[s.data.category] ??= []).push(s);
  }
  for (const cat of Object.keys(byCategory)) {
    byCategory[cat].sort((a, b) => {
      const da = new Date(a.data.date_added).getTime();
      const db = new Date(b.data.date_added).getTime();
      return da - db || a.data.slug.localeCompare(b.data.slug);
    });
  }
  const serialOf = new Map<string, number>();
  for (const cat of Object.keys(byCategory)) {
    byCategory[cat].forEach((s, i) => serialOf.set(s.data.slug, i + 1));
  }

  return services.map((service) => ({
    params: { slug: service.id },
    props: { service, serial: serialOf.get(service.data.slug) ?? 0 },
  }));
}

const { service, serial } = Astro.props as { service: ServiceEntry; serial: number };
const {
  name,
  summary,
  notes,
  brand_color,
  logo,
  tier_type,
  free_tier,
  pricing,
  tags,
  official_url,
  pricing_url,
  docs_url,
  category,
  date_added,
  date_verified,
  sources,
  // v4.0 — capture-everything blocks now rendered on the detail page when present.
  signup_friction,
  free_tier_limits,
  tos_red_flags,
  inactive_account_policy,
  support_sla,
  rate_limits,
  compliance_certifications,
} = service.data;

// Compose helpers — only render sections where there's actual data.
const hasFriction = signup_friction && Object.values(signup_friction).some((v) => v !== undefined);
const hasLimits = free_tier_limits && Object.values(free_tier_limits).some((v) => v !== undefined);
const hasRedFlags = Array.isArray(tos_red_flags) && tos_red_flags.length > 0;
const hasInactive =
  inactive_account_policy && Object.values(inactive_account_policy).some((v) => v !== undefined);
const hasOps =
  (support_sla && Object.values(support_sla).some((v) => v !== undefined)) ||
  (rate_limits && Object.values(rate_limits).some((v) => v !== undefined)) ||
  (Array.isArray(compliance_certifications) && compliance_certifications.length > 0);
const hasWatchFor = hasRedFlags || hasInactive;

const categoryEntry = await getEntry('categories', category);
const accent = brand_color ?? FALLBACK_BRAND_COLOR;

const siteUrl = 'https://opentier.dev';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name,
      description: summary,
      url: official_url,
      applicationCategory: 'DeveloperApplication',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        ...(pricing_url ? { url: pricing_url } : {}),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'All services',
          item: `${siteUrl}/catalog`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryEntry?.data.name ?? category,
          item: `${siteUrl}/category/${category}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name,
          item: `${siteUrl}/service/${service.id}`,
        },
      ],
    },
  ],
};

const verifiedDate = date_verified instanceof Date ? date_verified : new Date(date_verified);
const addedDate = date_added instanceof Date ? date_added : new Date(date_added);
const fmt = (d: Date) =>
  d
    .toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' })
    .toUpperCase()
    .replace(',', '');

const categoryUpper = (categoryEntry?.data.name ?? category).toUpperCase();
const serialStr = String(serial).padStart(3, '0');

// Roman-numeral section sequence — editorial almanac voice.
const roman = ['i.', 'ii.', 'iii.', 'iv.', 'v.', 'vi.', 'vii.', 'viii.', 'ix.', 'x.'];
// Each conditional section consumes the next roman numeral. Counter starts at
// 2 because i. = "Free tier" and ii. = "Pricing" are always present.
let romanIdx = 2;
const nextRoman = () => roman[romanIdx++];

// Sources / footnotes — flatten into a numbered list if present.
type Source = { url: string; verified?: string; label?: string };
const collectSources = (s: Sources | undefined): Source[] => {
  if (!s) return [];
  const out: Source[] = [];
  if (s.pricing?.url)
    out.push({ url: s.pricing.url, verified: s.pricing.verified, label: 'Pricing' });
  if (s.brand?.url) out.push({ url: s.brand.url, verified: s.brand.verified, label: 'Brand' });
  if (s.overrides) {
    for (const [field, o] of Object.entries(s.overrides)) {
      if (o?.url) out.push({ url: o.url, verified: o.verified, label: field });
    }
  }
  return out;
};
const footnotes = collectSources(sources);
---

<BaseLayout
  title={name}
  description={summary}
  canonical={`https://opentier.dev/service/${service.id}`}
  ogImage={`/og/${service.id}.png`}
  ogType="article"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="service-page" style={`--accent: ${accent};`}>
    <div class="container-narrow">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/catalog">All services</a>
        <span aria-hidden="true">›</span>
        <a href={`/category/${category}`}>{categoryEntry?.data.name ?? category}</a>
      </nav>

      {/* Editorial masthead: § CATEGORY · № SERIAL — sets the almanac tone. */}
      <p class="masthead">
        <span class="section-mark">§</span>
        <span class="cat">{categoryUpper}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="numero">№</span>
        <span class="serial">{serialStr}</span>
      </p>

      <header class="page-head">
        <div class="logo-large" aria-hidden="true">
          <img src={u(logo)} alt="" width="64" height="64" />
        </div>
        <div class="head-text">
          <h1>{name}</h1>
          <div class="badge-row">
            <TierBadge tier={tier_type} />
          </div>
        </div>
      </header>

      <p class="dateline">
        Verified <time datetime={verifiedDate.toISOString()}>{fmt(verifiedDate)}</time>
        <span class="dot" aria-hidden="true">·</span>
        Added <time datetime={addedDate.toISOString()}>{fmt(addedDate)}</time>
      </p>

      <p class="lede">{summary}</p>

      <section class="block">
        <h2><span class="rom">{roman[0]}</span> Free tier</h2>
        <ul class="free-tier">
          {free_tier.map((bullet: string) => <li>{bullet}</li>)}
        </ul>
      </section>

      <section class="block">
        <h2><span class="rom">{roman[1]}</span> Pricing</h2>
        <table class="pricing-table">
          <thead>
            <tr>
              <th>Plan</th>
              <th>Price</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {
              pricing.map((tier: PricingTier) => {
                const isFree = tier.name === 'Free' || tier.price === 0 || tier.price === 'Free';
                return (
                  <tr class={isFree ? 'free-row' : ''}>
                    <td class="plan">{tier.name}</td>
                    <td class="price">
                      {typeof tier.price === 'number' ? `$${tier.price}` : tier.price}
                      {tier.unit && <span class="unit">{tier.unit}</span>}
                    </td>
                    <td class="notes">{tier.description ?? ''}</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </section>

      {
        notes && (
          <section class="block">
            <h2>
              <span class="rom">{nextRoman()}</span> Limits & notes
            </h2>
            <p class="notes-body">{notes}</p>
          </section>
        )
      }

      {
        hasFriction && (
          <section class="block">
            <h2>
              <span class="rom">{nextRoman()}</span> Signup friction
            </h2>
            <ul class="friction-row">
              <li>
                Credit card:{' '}
                <strong>{signup_friction!.requires_cc ? 'required' : 'not required'}</strong>
              </li>
              {signup_friction!.phone_verification !== undefined && (
                <li>
                  Phone verification:{' '}
                  <strong>{signup_friction!.phone_verification ? 'required' : 'no'}</strong>
                </li>
              )}
              {signup_friction!.github_gate !== undefined && (
                <li>
                  GitHub-only signup: <strong>{signup_friction!.github_gate ? 'yes' : 'no'}</strong>
                </li>
              )}
              {signup_friction!.email_confirmation !== undefined && (
                <li>
                  Email confirmation:{' '}
                  <strong>{signup_friction!.email_confirmation ? 'required' : 'no'}</strong>
                </li>
              )}
            </ul>
          </section>
        )
      }

      {
        hasLimits && (
          <section class="block">
            <h2>
              <span class="rom">{nextRoman()}</span> Free-tier limits
            </h2>
            <ul class="limits-list">
              {free_tier_limits!.auto_pause_threshold_days !== undefined && (
                <li>
                  Auto-pause after{' '}
                  <strong>{free_tier_limits!.auto_pause_threshold_days} days</strong> of inactivity.
                </li>
              )}
              {free_tier_limits!.cold_start_latency_ms !== undefined && (
                <li>
                  Cold-start latency ~<strong>{free_tier_limits!.cold_start_latency_ms} ms</strong>.
                </li>
              )}
              {free_tier_limits!.account_age_gate_days !== undefined && (
                <li>
                  Account-age gate: <strong>{free_tier_limits!.account_age_gate_days} days</strong>.
                </li>
              )}
              {free_tier_limits!.geographic_regions &&
                free_tier_limits!.geographic_regions.length > 0 && (
                  <li>
                    Available in: <strong>{free_tier_limits!.geographic_regions.join(', ')}</strong>
                    .
                  </li>
                )}
            </ul>
          </section>
        )
      }

      {
        hasWatchFor && (
          <section class="block watch-for">
            <h2>
              <span class="rom">{nextRoman()}</span> Watch for
            </h2>
            <ul class="warn-list">
              {hasRedFlags && tos_red_flags!.map((flag: string) => <li class="warn">{flag}.</li>)}
              {hasInactive && inactive_account_policy!.days_until_deletion !== undefined && (
                <li class="warn">
                  Inactive accounts deleted after{' '}
                  <strong>{inactive_account_policy!.days_until_deletion} days</strong>
                  {inactive_account_policy!.warning_days !== undefined &&
                    ` (warning ${inactive_account_policy!.warning_days} days prior)`}
                  {inactive_account_policy!.data_recovery_possible === false &&
                    ' — no data recovery'}
                  .
                </li>
              )}
            </ul>
          </section>
        )
      }

      {
        hasOps && (
          <section class="block">
            <h2>
              <span class="rom">{nextRoman()}</span> Operational
            </h2>
            <dl class="ops-dl">
              {support_sla?.tier && (
                <>
                  <dt>Support tier</dt>
                  <dd>
                    {support_sla.tier}
                    {support_sla.availability && ` · ${support_sla.availability}`}
                    {support_sla.response_time_hours !== undefined &&
                      ` · ${support_sla.response_time_hours}h response`}
                  </dd>
                </>
              )}
              {rate_limits?.requests_per_second !== undefined && (
                <>
                  <dt>Rate limit</dt>
                  <dd>
                    {rate_limits.requests_per_second} req/sec
                    {rate_limits.concurrent_connections !== undefined &&
                      ` · ${rate_limits.concurrent_connections} concurrent`}
                  </dd>
                </>
              )}
              {Array.isArray(compliance_certifications) && compliance_certifications.length > 0 && (
                <>
                  <dt>Compliance</dt>
                  <dd>{compliance_certifications.join(' · ')}</dd>
                </>
              )}
            </dl>
          </section>
        )
      }

      <section class="block links">
        <h2><span class="rom">{nextRoman()}</span> Links</h2>
        <ul class="link-list">
          <li>
            <a href={official_url} rel="noopener noreferrer" target="_blank">Official site →</a>
          </li>
          {
            pricing_url && (
              <li>
                <a href={pricing_url} rel="noopener noreferrer" target="_blank">
                  Pricing page →
                </a>
              </li>
            )
          }
          {
            docs_url && (
              <li>
                <a href={docs_url} rel="noopener noreferrer" target="_blank">
                  Documentation →
                </a>
              </li>
            )
          }
        </ul>
      </section>

      {
        tags.length > 0 && (
          <section class="block">
            <h2>
              <span class="rom">{nextRoman()}</span> Tags
            </h2>
            <div class="tag-row">
              {tags.map((t: string) => (
                <span class="tag">#{t}</span>
              ))}
            </div>
          </section>
        )
      }

      {
        footnotes.length > 0 && (
          <section class="block sources">
            <h2>
              <span class="rom">{nextRoman()}</span> Sources
            </h2>
            <ol class="footnotes">
              {footnotes.map((f) => (
                <li>
                  <a href={f.url} rel="noopener noreferrer" target="_blank">
                    {f.label ?? 'Source'} — {f.url}
                  </a>
                  {f.verified && <span class="src-date"> · verified {f.verified}</span>}
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <footer class="page-footer">
        <p class="meta">
          <a
            href={`https://github.com/Pratiyush/opentier/edit/master/src/content/services/${service.id}.yml`}
            rel="noopener noreferrer"
          >
            Suggest an edit
          </a>
          {' · '}
          <a
            href={`https://github.com/Pratiyush/opentier/issues/new?title=Pricing+change%3A+${encodeURIComponent(name)}`}
            rel="noopener noreferrer"
          >
            Report pricing change
          </a>
        </p>
      </footer>
    </div>
  </article>

  <style>
    .service-page {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-2xl);
    }
    .breadcrumb {
      display: flex;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--color-ink-soft);
      margin-bottom: var(--space-lg);
    }
    .breadcrumb a {
      color: var(--color-ink-soft);
      text-decoration: none;
    }
    .breadcrumb a:hover {
      color: var(--color-ink);
    }

    /* Editorial masthead — § CATEGORY · № SERIAL in mono, ink-faint. */
    .masthead {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.16em;
      color: var(--color-ink-faint);
      margin: 0 0 var(--space-sm);
      display: flex;
      align-items: baseline;
      gap: 0.5em;
      flex-wrap: wrap;
    }
    .section-mark,
    .numero {
      color: var(--accent);
      font-weight: 500;
    }
    .dot {
      color: var(--color-rule);
    }

    .page-head {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-md);
      align-items: center;
      padding-bottom: var(--space-md);
      margin-bottom: var(--space-sm);
    }
    .logo-large {
      width: 72px;
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--color-paper);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-md);
      box-shadow: inset 0 0 0 4px color-mix(in srgb, var(--accent) 9%, transparent);
    }
    .logo-large img {
      width: 48px;
      height: 48px;
    }
    h1 {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5vw, 3.4rem);
      line-height: 1.05;
      letter-spacing: -0.015em;
      margin: 0;
      font-style: italic;
      font-weight: 400;
    }
    .badge-row {
      display: flex;
      gap: var(--space-sm);
      align-items: center;
      margin-top: var(--space-sm);
    }

    /* Dateline rule — VERIFIED <DATE> · ADDED <DATE>, JetBrains Mono uppercase. */
    .dateline {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      color: var(--color-ink-faint);
      padding: var(--space-xs) 0 var(--space-md);
      border-top: 1px solid var(--color-rule);
      border-bottom: 1px solid var(--color-rule);
      margin: 0 0 var(--space-lg);
      display: flex;
      gap: 0.6em;
      flex-wrap: wrap;
    }
    .dateline time {
      color: var(--color-ink-soft);
      font-weight: 500;
    }

    .lede {
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 2.2vw, 1.35rem);
      color: var(--color-ink);
      line-height: 1.55;
      margin: 0 0 var(--space-xl);
      max-width: 58ch;
      font-weight: 350;
    }

    .block {
      padding: var(--space-lg) 0;
      border-top: var(--border-rule);
    }
    .block h2 {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 500;
      margin: 0 0 var(--space-md);
      display: flex;
      align-items: baseline;
      gap: 0.5em;
    }
    /* Roman numeral on each section heading — small italic Fraunces in accent color. */
    .rom {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 0.85em;
      font-weight: 400;
      color: var(--accent-readable); /* darkened coral — --accent (#b73d22) fails 4.5:1 on paper */
    }

    .free-tier {
      list-style: none;
      padding: 0;
      display: grid;
      gap: var(--space-sm);
    }
    .free-tier li {
      padding-left: 1.4rem;
      text-indent: -1.4rem;
    }
    .free-tier li::before {
      content: '— ';
      color: var(--accent);
      font-weight: 500;
    }

    .pricing-table {
      width: 100%;
      border-collapse: collapse;
    }
    .pricing-table th,
    .pricing-table td {
      text-align: left;
      padding: var(--space-sm) var(--space-md);
      border-bottom: var(--border-rule);
      font-size: 0.95rem;
      vertical-align: top;
    }
    .pricing-table th {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-ink-faint);
      font-weight: 500;
    }
    .pricing-table td.plan {
      font-weight: 500;
    }
    .pricing-table td.price {
      font-family: var(--font-mono);
    }
    .pricing-table tr:last-child td {
      border-bottom: none;
    }

    /* Free row gets italic Fraunces in brand-color — the editorial flourish. */
    .pricing-table .free-row td {
      background: color-mix(in srgb, var(--accent) 6%, transparent);
    }
    .pricing-table .free-row td.plan,
    .pricing-table .free-row td.price {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 400;
      color: var(--accent-readable); /* darkened coral — fails 4.5:1 on 6% accent tint */
      font-size: 1.05rem;
    }
    .pricing-table .free-row td.notes {
      color: var(--color-ink);
    }
    .pricing-table .unit {
      color: var(--color-ink-soft);
      font-size: 0.9em;
      margin-left: 0.2rem;
    }

    .notes-body {
      max-width: 65ch;
      line-height: 1.65;
      color: var(--color-ink);
    }

    .link-list {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }
    .link-list a {
      /* Don't use var(--accent) — per-service brand overrides may fail 4.5:1.
       * Fixed dark coral guarantees contrast across all 300 brand variants. */
      color: var(--accent-readable);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 0.92rem;
    }
    .link-list a:hover {
      text-decoration: underline;
      text-decoration-color: var(--accent);
    }

    .tag-row {
      display: flex;
      gap: var(--space-xs);
      flex-wrap: wrap;
    }
    .tag {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--color-ink-soft);
    }

    /* v4.0 — capture-everything rendering. Plain prose, hanging em-dashes,
       no heavy chrome. Matches the almanac voice. */
    .friction-row,
    .limits-list,
    .warn-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-size: 0.92rem;
      color: var(--color-ink-soft);
    }
    .friction-row li::before,
    .limits-list li::before,
    .warn-list li::before {
      content: '—  ';
      color: var(--accent);
    }
    .warn-list .warn {
      color: var(--color-ink);
    }
    .watch-for {
      background: color-mix(in srgb, var(--color-coral) 4%, transparent);
      padding: var(--space-md);
      border-left: 3px solid var(--color-coral);
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }
    .ops-dl {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.4rem var(--space-md);
      font-size: 0.9rem;
    }
    .ops-dl dt {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-ink-faint);
      align-self: baseline;
    }
    .ops-dl dd {
      margin: 0;
      color: var(--color-ink-soft);
    }

    .footnotes {
      list-style: decimal;
      padding-left: 1.4rem;
      color: var(--color-ink-soft);
      font-size: 0.88rem;
      line-height: 1.55;
    }
    .footnotes li {
      margin-bottom: 0.4rem;
    }
    .footnotes a {
      color: var(--color-ink);
      text-decoration: underline;
      text-decoration-color: var(--color-rule);
    }
    .footnotes a:hover {
      text-decoration-color: var(--accent);
    }
    .src-date {
      font-family: var(--font-mono);
      font-size: 0.78em;
      color: var(--color-ink-faint);
    }

    .page-footer {
      padding-top: var(--space-xl);
      border-top: var(--border-rule);
    }
    .meta {
