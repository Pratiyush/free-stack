---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import TierBadge from '~/components/ui/TierBadge.astro';
import CategoryChip from '~/components/ui/CategoryChip.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const {
  name,
  summary,
  notes,
  brand_color,
  logo,
  tier_type,
  free_tier,
  pricing,
  tags,
  official_url,
  pricing_url,
  docs_url,
  category,
  date_added,
  date_verified,
} = service.data;

const categoryEntry = await getEntry('categories', category);
const accent = brand_color ?? '#1a1a1a';

// Schema.org JSON-LD record (SoftwareApplication). Emitted in <head> for SEO.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description: summary,
  url: official_url,
  applicationCategory: 'DeveloperApplication',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    ...(pricing_url ? { url: pricing_url } : {}),
  },
};
const verifiedDate = date_verified instanceof Date ? date_verified : new Date(date_verified);
const verifiedDisplay = verifiedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const addedDate = date_added instanceof Date ? date_added : new Date(date_added);
const addedDisplay = addedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<BaseLayout
  title={name}
  description={summary}
  canonical={`https://freestack.is-a.dev/service/${service.id}`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="service-page" style={`--accent: ${accent};`}>
    <div class="container-narrow">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/catalog">All services</a>
        <span aria-hidden="true">›</span>
        <a href={`/category/${category}`}>{categoryEntry?.data.name ?? category}</a>
      </nav>

      <header class="page-head">
        <div class="logo-large" aria-hidden="true">
          <img src={logo} alt="" width="64" height="64" />
        </div>
        <div class="head-text">
          <p class="eyebrow">{categoryEntry?.data.name ?? category}</p>
          <h1>{name}</h1>
          <div class="badge-row">
            <TierBadge tier={tier_type} />
            <span class="verified" title={`Verified ${verifiedDisplay}`}>
              Verified <time datetime={verifiedDate.toISOString()}>{verifiedDisplay}</time>
            </span>
          </div>
        </div>
      </header>

      <p class="lede">{summary}</p>

      <section class="block">
        <h2>What you get on the free tier</h2>
        <ul class="free-tier">
          {free_tier.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </section>

      <section class="block">
        <h2>Pricing</h2>
        <table class="pricing-table">
          <thead>
            <tr>
              <th>Plan</th>
              <th>Price</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {
              pricing.map((tier) => (
                <tr>
                  <td>
                    <strong>{tier.name}</strong>
                  </td>
                  <td>
                    {typeof tier.price === 'number' ? `$${tier.price}` : tier.price}
                    {tier.unit && <span class="unit">{tier.unit}</span>}
                  </td>
                  <td>{tier.description ?? ''}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>

      {
        notes && (
          <section class="block">
            <h2>Notes</h2>
            <p>{notes}</p>
          </section>
        )
      }

      <section class="block links">
        <h2>Links</h2>
        <ul class="link-list">
          <li>
            <a href={official_url} rel="noopener noreferrer" target="_blank"> Official site → </a>
          </li>
          {
            pricing_url && (
              <li>
                <a href={pricing_url} rel="noopener noreferrer" target="_blank">
                  Pricing page →
                </a>
              </li>
            )
          }
          {
            docs_url && (
              <li>
                <a href={docs_url} rel="noopener noreferrer" target="_blank">
                  Documentation →
                </a>
              </li>
            )
          }
        </ul>
      </section>

      {
        tags.length > 0 && (
          <section class="block">
            <h2>Tags</h2>
            <div class="tag-row">
              {tags.map((t) => (
                <span class="tag">#{t}</span>
              ))}
            </div>
          </section>
        )
      }

      <footer class="page-footer">
        <p class="meta">
          Added {addedDisplay}. Last verified <time datetime={verifiedDate.toISOString()}
            >{verifiedDisplay}</time
          >.
          {' '}
          <a
            href={`https://github.com/Pratiyush/free-stack/edit/master/src/content/services/${service.id}.yml`}
            rel="noopener noreferrer"
          >
            Suggest an edit
          </a>.
        </p>
      </footer>
    </div>
  </article>

  <style>
    .service-page {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-2xl);
    }
    .breadcrumb {
      display: flex;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--color-ink-soft);
      margin-bottom: var(--space-md);
    }
    .breadcrumb a {
      color: var(--color-ink-soft);
      text-decoration: none;
    }
    .breadcrumb a:hover {
      color: var(--color-ink);
    }
    .page-head {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-md);
      align-items: center;
      padding-bottom: var(--space-md);
      border-bottom: 4px solid var(--accent);
      margin-bottom: var(--space-lg);
    }
    .logo-large {
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
    }
    .logo-large img {
      width: 48px;
      height: 48px;
    }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-ink-soft);
    }
    h1 {
      margin-top: var(--space-xs);
    }
    .badge-row {
      display: flex;
      gap: var(--space-sm);
      align-items: center;
      margin-top: var(--space-sm);
    }
    .verified {
      font-size: 0.82rem;
      color: var(--color-ink-soft);
    }
    .lede {
      font-size: 1.2rem;
      color: var(--color-ink);
      line-height: 1.55;
      margin-bottom: var(--space-xl);
      max-width: 65ch;
    }
    .block {
      padding: var(--space-lg) 0;
      border-top: var(--border-rule);
    }
    .block h2 {
      font-size: 1.35rem;
      margin-bottom: var(--space-md);
    }
    .free-tier {
      list-style: none;
      padding: 0;
      display: grid;
      gap: var(--space-sm);
    }
    .free-tier li {
      padding-left: 1.5rem;
      position: relative;
    }
    .free-tier li::before {
      content: '✓';
      position: absolute;
      left: 0;
      top: 0;
      color: var(--accent);
      font-weight: 600;
    }
    .pricing-table {
      width: 100%;
      border-collapse: collapse;
    }
    .pricing-table th,
    .pricing-table td {
      text-align: left;
      padding: var(--space-sm) var(--space-md);
      border-bottom: var(--border-rule);
      font-size: 0.95rem;
      vertical-align: top;
    }
    .pricing-table th {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-ink-soft);
      font-weight: 500;
    }
    .pricing-table tr:last-child td {
      border-bottom: none;
    }
    .pricing-table .unit {
      color: var(--color-ink-soft);
      font-size: 0.92em;
      margin-left: 0.25rem;
    }
    .link-list {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }
    .link-list a {
      color: var(--accent);
      text-decoration: none;
    }
    .link-list a:hover {
      text-decoration: underline;
      text-decoration-color: var(--accent);
    }
    .tag-row {
      display: flex;
      gap: var(--space-xs);
      flex-wrap: wrap;
    }
    .tag {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--color-ink-soft);
    }
    .page-footer {
      padding-top: var(--space-xl);
      border-top: var(--border-rule);
    }
    .meta {
      font-size: 0.88rem;
      color: var(--color-ink-soft);
    }
    .meta a {
      color: var(--color-ink-soft);
    }
  </style>
</BaseLayout>
