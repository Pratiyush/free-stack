---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import CategoryChip from '~/components/ui/CategoryChip.astro';
import { FALLBACK_BRAND_COLOR, PLACEHOLDER_BRAND_COLOR } from '~/lib/theme';

const services = await getCollection('services');
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);

const countByCategory = new Map<string, number>();
for (const s of services) {
  countByCategory.set(s.data.category, (countByCategory.get(s.data.category) ?? 0) + 1);
}

const recentlyVerified = [...services]
  .sort(
    (a, b) => new Date(b.data.date_verified).getTime() - new Date(a.data.date_verified).getTime(),
  )
  .slice(0, 6);

/* Periodic-table wall — 48 services with real brand_color, 6-col grid below.
 * Sorted by date_added (newest first) so the wall feels fresh each release. */
const wallServices = services
  .filter(
    (s) =>
      s.data.brand_color &&
      s.data.brand_color !== PLACEHOLDER_BRAND_COLOR &&
      s.data.brand_color.toLowerCase() !== FALLBACK_BRAND_COLOR,
  )
  .sort((a, b) => new Date(b.data.date_added).getTime() - new Date(a.data.date_added).getTime())
  .slice(0, 48);

/* Editorial Issue №. v0.9.0 = Issue №009. Bumped at tag time. */
const issueNumber = '009';

/* Schema.org JSON-LD — Organization + WebSite (with SearchAction) on the home page. */
const siteUrl = 'https://opentier.dev';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'opentier',
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      sameAs: ['https://github.com/Pratiyush/opentier'],
      description:
        'Open-source catalogue of verified free-tier developer services. No ads, no affiliate links.',
    },
    {
      '@type': 'WebSite',
      name: 'opentier',
      url: siteUrl,
      description: `${services.length} developer services with real free tiers — verified monthly.`,
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteUrl}/catalog?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
const issueMonth = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const verifiedToday = new Date()
  .toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
  })
  .toUpperCase()
  .replace(',', '');
---

<BaseLayout
  title="opentier"
  description={`${services.length} verified free tiers for developers. No ads, no affiliate links — just the free tier you can actually use.`}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <div class="container hero-inner">
      {
        /* Masthead — Issue № + dateline now lives ABOVE the h1 inside the hero, not as a separate bar. */
      }
      <p class="masthead">
        <span class="issue">Issue №{issueNumber}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="month">{issueMonth}</span>
        <span class="rule" aria-hidden="true"></span>
        <span class="verified-line">VERIFIED {verifiedToday}</span>
      </p>

      <div class="hero-grid">
        <div class="hero-text">
          <h1 class="hero-h1">
            One <em>honest</em> directory of free tiers<br />
            that <em>actually</em> stay free.
          </h1>
          <p class="lede">
            {services.length} developer services with real free tiers — permanent, not 14-day trials.
            Every entry verified against the official pricing page. No ads. No affiliate links. No paid
            placement.
          </p>
          <div class="cta-row">
            <a class="cta-primary" href="/catalog">Browse {services.length} services →</a>
            <a class="cta-secondary" href="/methodology">How we verify</a>
          </div>
        </div>

        <aside class="hero-side">
          {/* Sidebar pull-quote — drawn from ref/docs/CONVERSATION.md:18. */}
          <figure class="pull-quote">
            <blockquote>
              <p>
                A wall of crisp, monochrome logos that <em>lights up in color</em> as you hover — like
                a periodic table of the free internet.
              </p>
            </blockquote>
            <figcaption>— design intent, 2026</figcaption>
          </figure>

          <dl class="hero-stats" aria-label="Site stats">
            <div class="stat">
              <dt>Services</dt>
              <dd>{services.length}</dd>
            </div>
            <div class="stat">
              <dt>Categories</dt>
              <dd>{categories.length}</dd>
            </div>
            <div class="stat">
              <dt>Affiliate links</dt>
              <dd>0</dd>
            </div>
            <div class="stat">
              <dt>Ads / trackers</dt>
              <dd>0</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  {/* Periodic table — 6-col wall of brand-colored logos with names visible by default. */}
  <section class="wall-section container">
    <header class="section-head">
      <p class="rom-eyebrow"><span class="rom">i.</span> The periodic table</p>
      <h2>{wallServices.length} services, at a glance.</h2>
      <p class="section-blurb">
        Every tile is a service we've verified this month. Click any to open its pricing breakdown.
      </p>
    </header>
    <div class="wall" role="list">
      {
        wallServices.map((s) => (
          <a
            class="wall-tile"
            role="listitem"
            href={`/service/${s.data.slug}`}
            style={`--tile-accent: ${s.data.brand_color};`}
            aria-label={s.data.name}
            transition:name={`card-${s.data.slug}`}
          >
            <img src={s.data.logo} alt="" loading="lazy" width="36" height="36" />
            <span class="tile-name">{s.data.name}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container categories-section">
    <header class="section-head">
      <p class="rom-eyebrow"><span class="rom">ii.</span> Browse by category</p>
      <h2>{categories.length} layers of the stack.</h2>
    </header>
    <div class="category-grid">
      {
        categories.map((c) => (
          <CategoryChip slug={c.id} name={c.data.name} count={countByCategory.get(c.id) ?? 0} />
        ))
      }
    </div>
  </section>

  <section class="container recently-section">
    <header class="section-head">
      <p class="rom-eyebrow"><span class="rom">iii.</span> Recently verified</p>
      <h2>Six entries last re-checked.</h2>
    </header>
    <div class="recent-grid">
      {
        recentlyVerified.map((s) => {
          const cat = categories.find((c) => c.id === s.data.category);
          return <ServiceCard service={s} categoryName={cat?.data.name} variant="compact" />;
        })
      }
    </div>
  </section>

  <section class="container-narrow about">
    <p class="rom-eyebrow"><span class="rom">iv.</span> Why this exists</p>
    <h2>The free-tier list, kept honest.</h2>
    <p>
      Every "awesome free tier" list inevitably rots. Services kill their free tiers; tables get
      stale; nobody knows what's actually still free. opentier solves that with a single rule:
      every entry must point at today's pricing page, and every entry has a "verified" date you can
      hold us to.
    </p>
    <p>
      The project is open source and non-commercial. The only money is voluntary sponsorship via
      GitHub Sponsors and Buy Me a Coffee — used to cover the domain and hosting bill, nothing else.
      <a href="/sponsors">More on sponsorship →</a>
    </p>
  </section>

  <style>
    /* Hero with paper-cream base + soft radial coral tints + radial brand wash. */
    .hero {
      background:
        radial-gradient(
          ellipse at 0% 0%,
          color-mix(in srgb, var(--color-coral) 8%, transparent),
          transparent 50%
        ),
        radial-gradient(
          ellipse at 100% 100%,
          color-mix(in srgb, var(--color-coral) 5%, transparent),
          transparent 60%
        ),
        var(--color-paper);
      border-bottom: 1px solid var(--color-rule);
    }
    .hero-inner {
      padding: var(--space-lg) var(--space-md) var(--space-2xl);
    }

    /* Masthead — sits ABOVE the h1 now, inside the hero. */
    .masthead {
      display: flex;
      align-items: center;
      gap: 0.6em;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      color: var(--color-ink-faint);
      margin: 0 0 var(--space-lg);
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid var(--color-rule);
      flex-wrap: wrap;
    }
    .masthead .issue {
      color: var(--color-coral);
      font-weight: 500;
    }
    .masthead .month {
      color: var(--color-ink-soft);
    }
    .masthead .verified-line {
      color: var(--color-ink-soft);
      font-weight: 500;
    }
    .masthead .dot {
      color: var(--color-rule);
    }
    .masthead .rule {
      flex: 1;
      height: 1px;
      background: var(--color-rule);
      min-width: 1em;
    }

    /* 3:2 grid — h1+lede left, pull-quote+stats right. */
    .hero-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-2xl);
      align-items: start;
    }
    @media (max-width: 880px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
    }

    /* The big h1 — bigger than v0.8.0 (was 4.4rem cap, now 5.5rem). */
    .hero-h1 {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 5.5rem);
      line-height: 1.02;
      letter-spacing: -0.02em;
      font-weight: 350;
      margin: 0;
      font-feature-settings: 'ss01';
    }
    .hero-h1 em {
      font-style: italic;
      color: var(--color-coral);
      font-weight: 400;
    }
    /* Fade-in on first paint via @starting-style; respects reduce-motion. */
    @media (prefers-reduced-motion: no-preference) {
      .hero-h1 {
        opacity: 1;
        transform: translateY(0);
        transition:
          opacity 0.6s ease,
          transform 0.6s cubic-bezier(0.2, 0, 0, 1);
      }
      @starting-style {
        .hero-h1 {
          opacity: 0;
          transform: translateY(8px);
        }
      }
    }

    .lede {
      font-family: var(--font-display);
      font-size: clamp(1.1rem, 1.8vw, 1.25rem);
      color: var(--color-ink);
      line-height: 1.55;
      margin: var(--space-lg) 0 0;
      max-width: 58ch;
      font-weight: 350;
    }

    .cta-row {
      display: flex;
      gap: var(--space-md);
      margin-top: var(--space-lg);
      flex-wrap: wrap;
    }
    .cta-primary,
    .cta-secondary {
      display: inline-block;
      padding: 0.7rem 1.3rem;
      border-radius: var(--radius-md);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.15s ease;
      font-family: var(--font-body);
    }
    .cta-primary {
      background: var(--color-ink);
      color: var(--color-paper);
    }
    .cta-primary:hover {
      background: var(--color-coral);
    }
    .cta-secondary {
      background: transparent;
      color: var(--color-ink);
      border: 1px solid var(--color-rule);
    }
    .cta-secondary:hover {
      border-color: var(--color-ink);
    }

    /* Sidebar — pull-quote + stats stacked. */
    .hero-side {
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
    }
    .pull-quote {
      margin: 0;
      padding: var(--space-md) var(--space-md) var(--space-md) var(--space-lg);
      border-left: 3px solid var(--color-coral);
      background: var(--color-paper-warm);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }
    .pull-quote blockquote {
      margin: 0;
    }
    .pull-quote p {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.05rem;
      line-height: 1.5;
      color: var(--color-ink);
      margin: 0;
      font-weight: 350;
    }
    .pull-quote em {
      color: var(--color-coral);
      font-style: italic;
    }
    .pull-quote figcaption {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-ink-faint);
      margin-top: var(--space-sm);
    }

    .hero-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md) var(--space-lg);
      margin: 0;
    }
    .hero-stats .stat dt {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-ink-faint);
    }
    .hero-stats .stat dd {
      margin: 0.2rem 0 0;
      font-family: var(--font-display);
      font-size: 1.9rem;
      font-weight: 400;
      color: var(--color-ink);
      line-height: 1;
      font-feature-settings: 'tnum';
    }

    /* Periodic-table wall — 6-col fixed grid (responsive down). Names visible by default. */
    .wall-section {
      padding-top: var(--space-2xl);
    }
    .wall {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1px;
      margin-top: var(--space-lg);
      background: var(--color-rule);
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    @media (max-width: 1080px) {
      .wall {
        grid-template-columns: repeat(4, 1fr);
      }
    }
    @media (max-width: 640px) {
      .wall {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (max-width: 420px) {
      .wall {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .wall-tile {
      position: relative;
      aspect-ratio: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: var(--space-sm);
      text-decoration: none;
      background: color-mix(in srgb, var(--tile-accent) 6%, var(--color-paper));
      transition:
        background 0.18s ease,
        transform 0.18s ease;
    }
    .wall-tile img {
      width: 36px;
      height: 36px;
      object-fit: contain;
      transition: transform 0.18s ease;
      filter: grayscale(0.3) opacity(0.92);
    }
    .wall-tile .tile-name {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: var(--color-ink-soft);
      letter-spacing: 0.03em;
      text-align: center;
      line-height: 1.2;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .wall-tile:hover,
    .wall-tile:focus-visible {
      background: color-mix(in srgb, var(--tile-accent) 24%, var(--color-paper));
      transform: scale(1.06);
      z-index: 2;
      outline: none;
    }
    .wall-tile:hover img,
    .wall-tile:focus-visible img {
      filter: none;
      transform: scale(1.1);
    }
    .wall-tile:hover .tile-name,
    .wall-tile:focus-visible .tile-name {
      color: var(--color-ink);
    }
    .wall-tile:focus-visible {
      outline: 2px solid var(--color-coral);
      outline-offset: -2px;
    }

    .section-head {
      margin-bottom: var(--space-md);
    }
    .rom-eyebrow {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--color-ink-faint);
      margin: 0 0 var(--space-xs);
    }
    .rom {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--color-coral);
      font-size: 1.1em;
      margin-right: 0.4em;
    }
    .section-head h2 {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3vw, 2.1rem);
      font-weight: 400;
      margin: 0;
      letter-spacing: -0.01em;
    }
    .section-blurb {
      color: var(--color-ink-soft);
      margin-top: var(--space-sm);
      max-width: 56ch;
      line-height: 1.55;
    }

    .categories-section,
    .recently-section {
      padding-top: var(--space-2xl);
    }
    .category-grid {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
      margin-top: var(--space-md);
    }
    .recent-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-md);
      margin-top: var(--space-md);
    }
    .about {
      padding-top: var(--space-2xl);
      padding-bottom: var(--space-2xl);
    }
    .about h2 {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3vw, 2.1rem);
      font-weight: 400;
      margin: var(--space-xs) 0 var(--space-md);
      letter-spacing: -0.01em;
    }
    .about p {
      margin-top: var(--space-md);
      line-height: 1.65;
      max-width: 65ch;
    }
    .about a {
      color: var(--color-ink);
    }
    .about a:hover {
      color: var(--color-coral);
    }
  </style>
</BaseLayout>
