---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import CategoryChip from '~/components/ui/CategoryChip.astro';

const services = await getCollection('services');
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);

const countByCategory = new Map<string, number>();
for (const s of services) {
  countByCategory.set(s.data.category, (countByCategory.get(s.data.category) ?? 0) + 1);
}

const recentlyVerified = [...services]
  .sort(
    (a, b) => new Date(b.data.date_verified).getTime() - new Date(a.data.date_verified).getTime(),
  )
  .slice(0, 6);
---

<BaseLayout
  title="free-stack"
  description={`${services.length} verified free tiers for developers. No ads, no affiliate links — just the free tier you can actually use.`}
>
  <section class="hero container-narrow">
    <p class="eyebrow">
      Free Tiers · Verified {
        new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
      }
    </p>
    <h1>Free tools that stay free.</h1>
    <p class="lede">
      A directory of developer services with real free tiers — permanent, not 14-day trials. Every
      entry is verified against the official pricing page. No ads, no affiliate links, no paid
      placement.
    </p>
    <div class="cta-row">
      <a class="cta-primary" href="/catalog">Browse {services.length} services</a>
      <a class="cta-secondary" href="/methodology">How we verify</a>
    </div>
  </section>

  <section class="stats container">
    <div class="stat">
      <span class="stat-num">{services.length}</span>
      <span class="stat-label">verified services</span>
    </div>
    <div class="stat">
      <span class="stat-num">{categories.length}</span>
      <span class="stat-label">categories</span>
    </div>
    <div class="stat">
      <span class="stat-num">$0</span>
      <span class="stat-label">to start</span>
    </div>
    <div class="stat">
      <span class="stat-num">0</span>
      <span class="stat-label">affiliate links</span>
    </div>
  </section>

  <section class="container categories-section">
    <header class="section-head">
      <h2>Browse by category</h2>
      <p class="section-blurb">
        Pick a category to see every service we trust at that layer of the stack.
      </p>
    </header>
    <div class="category-grid">
      {
        categories.map((c) => (
          <CategoryChip slug={c.id} name={c.data.name} count={countByCategory.get(c.id) ?? 0} />
        ))
      }
    </div>
  </section>

  <section class="container recently-section">
    <header class="section-head">
      <h2>Recently verified</h2>
      <p class="section-blurb">The six most recently re-checked entries.</p>
    </header>
    <div class="grid">
      {
        recentlyVerified.map((s) => {
          const cat = categories.find((c) => c.id === s.data.category);
          return <ServiceCard service={s} categoryName={cat?.data.name} variant="compact" />;
        })
      }
    </div>
  </section>

  <section class="container-narrow about">
    <h2>Why this exists.</h2>
    <p>
      Every "awesome free tier" list inevitably rots. Services kill their free tiers; tables get
      stale; nobody knows what's actually still free. free-stack solves that with a single rule:
      every entry must point at today's pricing page, and every entry has a "verified" date you can
      hold us to.
    </p>
    <p>
      The project is open source and non-commercial. The only money is voluntary sponsorship via
      GitHub Sponsors and Buy Me a Coffee — used to cover the domain and hosting bill, nothing else. <a
        href="/sponsors">More on sponsorship</a
      >.
    </p>
  </section>

  <style>
    .hero {
      padding-top: var(--space-2xl);
      padding-bottom: var(--space-xl);
    }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-ink-soft);
      margin-bottom: var(--space-md);
    }
    .lede {
      margin-top: var(--space-md);
      font-size: 1.15rem;
      color: var(--color-ink-soft);
      max-width: 56ch;
    }
    .cta-row {
      display: flex;
      gap: var(--space-md);
      margin-top: var(--space-lg);
      flex-wrap: wrap;
    }
    .cta-primary,
    .cta-secondary {
      display: inline-block;
      padding: 0.7rem 1.2rem;
      border-radius: var(--radius-md);
      text-decoration: none;
      font-weight: 500;
      transition: all 0.15s ease;
    }
    .cta-primary {
      background: var(--color-ink);
      color: var(--color-paper);
    }
    .cta-primary:hover {
      background: var(--color-coral);
    }
    .cta-secondary {
      background: transparent;
      color: var(--color-ink);
      border: 1px solid var(--color-rule);
    }
    .cta-secondary:hover {
      border-color: var(--color-ink);
    }
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-lg);
      padding: var(--space-xl) var(--space-md);
      border-top: var(--border-rule);
      border-bottom: var(--border-rule);
      margin-top: var(--space-xl);
    }
    .stat {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }
    .stat-num {
      font-family: var(--font-display);
      font-size: 2.5rem;
      font-weight: 400;
      color: var(--color-ink);
      line-height: 1;
    }
    .stat-label {
      font-size: 0.85rem;
      color: var(--color-ink-soft);
      text-transform: lowercase;
      letter-spacing: 0.02em;
    }
    .categories-section,
    .recently-section {
      padding-top: var(--space-2xl);
    }
    .section-head {
      margin-bottom: var(--space-md);
    }
    .section-head h2 {
      font-size: 1.6rem;
    }
    .section-blurb {
      color: var(--color-ink-soft);
      margin-top: var(--space-xs);
    }
    .category-grid {
      display: flex;
      gap: var(--space-sm);
      flex-wrap: wrap;
      margin-top: var(--space-md);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-md);
      margin-top: var(--space-md);
    }
    .about {
      padding-top: var(--space-2xl);
    }
    .about p {
      margin-top: var(--space-md);
    }
    @media (max-width: 720px) {
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
</BaseLayout>
