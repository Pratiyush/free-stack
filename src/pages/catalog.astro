---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServiceCard from '~/components/ui/ServiceCard.astro';
import ServiceTable from '~/components/ui/ServiceTable.astro';
import SearchBox from '~/components/ui/SearchBox.astro';
import ViewToggle from '~/components/ui/ViewToggle.astro';
import { TIER_LABELS } from '~/lib/labels';

const services = (await getCollection('services')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);

const tierTypes = ['always-free', 'free-plan', 'trial-credit', 'pay-as-you-go'] as const;
---

<BaseLayout
  title="Catalog"
  description={`Browse ${services.length} verified free tiers for developers. Filter by category and tier type.`}
  canonical="https://freestack.is-a.dev/catalog"
>
  <section class="catalog container">
    <header class="catalog-head container-narrow">
      <p class="eyebrow">
        Catalog · {services.length} services across {categories.length} categories
      </p>
      <h1>Every free tier we trust.</h1>
      <p class="lede">
        Filter by tier type or category. Each entry has been verified against the official pricing
        page within the last 30 days.
      </p>
      <div class="search-row">
        <SearchBox placeholder={`Search ${services.length} services…`} id="catalog-search" />
      </div>
    </header>

    <div class="filters" role="region" aria-label="Filters">
      <fieldset class="filter-group">
        <legend>Tier type</legend>
        <div class="filter-buttons">
          <button type="button" data-filter-tier="" class="filter-btn active">All</button>
          {
            tierTypes.map((t) => (
              <button type="button" data-filter-tier={t} class="filter-btn">
                {TIER_LABELS[t]}
              </button>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="filter-group">
        <legend>Category</legend>
        <select class="filter-select" data-filter-category>
          <option value="">All categories</option>
          {categories.map((c) => <option value={c.id}>{c.data.name}</option>)}
        </select>
      </fieldset>
    </div>

    <div class="result-row">
      <p class="result-count" data-result-count>{services.length} services</p>
      <ViewToggle />
    </div>

    <div class="grid" data-view="grid" data-grid>
      {
        services.map((s) => {
          const cat = categories.find((c) => c.id === s.data.category);
          return <ServiceCard service={s} categoryName={cat?.data.name} />;
        })
      }
    </div>

    <div data-view="table" hidden>
      <ServiceTable services={services} />
    </div>

    <div class="no-results" data-no-results hidden role="status" aria-live="polite">
      <p class="no-results-title">No services match these filters.</p>
      <p class="no-results-hint">
        Try a different search term, clear the category filter, or
        <a href="/catalog">reset filters</a>.
      </p>
    </div>
  </section>

  <script>
    const grid = document.querySelector<HTMLElement>('[data-grid]');
    const tierBtns = document.querySelectorAll<HTMLButtonElement>('[data-filter-tier]');
    const catSelect = document.querySelector<HTMLSelectElement>('[data-filter-category]');
    const searchInput = document.querySelector<HTMLInputElement>('#catalog-search');
    const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
    const cards = Array.from(grid?.querySelectorAll<HTMLElement>('.service-card') ?? []);
    // Table rows share data-slug / data-tier / data-category with cards.
    const tableRows = Array.from(
      document.querySelectorAll<HTMLElement>('[data-view="table"] .row[data-slug]'),
    );
    // Tag table rows with the same data-tier / data-category as cards.
    // Also stash a lowercase search-text per card + row (name + slug + category).
    cards.forEach((card) => {
      const slug = card.dataset.slug ?? '';
      const name = card.querySelector('.card-name')?.textContent ?? '';
      const cat = card.dataset.category ?? '';
      card.dataset.searchText = `${name} ${slug} ${cat}`.toLowerCase();
    });
    tableRows.forEach((row) => {
      const slug = row.dataset.slug;
      const matchingCard = cards.find((c) => c.dataset.slug === slug);
      if (matchingCard) {
        row.dataset.tier = matchingCard.dataset.tier ?? '';
        row.dataset.category = matchingCard.dataset.category ?? '';
        row.dataset.searchText = matchingCard.dataset.searchText ?? '';
      }
    });

    function applyFilters() {
      const tier = document.querySelector<HTMLButtonElement>('[data-filter-tier].active')?.dataset
        .filterTier;
      const cat = catSelect?.value;
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matchTier = !tier || card.dataset.tier === tier;
        const matchCat = !cat || card.dataset.category === cat;
        const matchQ = !q || (card.dataset.searchText ?? '').includes(q);
        const show = matchTier && matchCat && matchQ;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      // Table rows: hide both the row AND its detail row when filtered out.
      tableRows.forEach((row) => {
        const matchTier = !tier || row.dataset.tier === tier;
        const matchCat = !cat || row.dataset.category === cat;
        const matchQ = !q || (row.dataset.searchText ?? '').includes(q);
        const show = matchTier && matchCat && matchQ;
        row.style.display = show ? '' : 'none';
        const detailId = row.getAttribute('aria-controls');
        const detail = detailId ? document.getElementById(detailId) : null;
        if (detail) detail.style.display = show ? '' : 'none';
      });
      if (resultCount) resultCount.textContent = `${visible} service${visible === 1 ? '' : 's'}`;
      // Toggle a zero-state message when nothing matches.
      const empty = document.querySelector<HTMLElement>('[data-no-results]');
      if (empty) empty.toggleAttribute('hidden', visible !== 0);
    }

    tierBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tierBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilters();
      });
    });
    catSelect?.addEventListener('change', applyFilters);
    // Debounced search-input handler.
    let searchTimer: ReturnType<typeof setTimeout> | null = null;
    searchInput?.addEventListener('input', () => {
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(applyFilters, 80);
    });

    /* Sticky filter bar — apply shadow when the bar is stuck to the viewport top.
       Pattern adapted from ref/design-experiments/combined-v2.html (sentinel). */
    const filterBar = document.querySelector<HTMLElement>('.filters');
    if (filterBar) {
      const sentinel = document.createElement('span');
      sentinel.style.cssText = 'display:block;height:1px;width:1px;';
      filterBar.parentElement?.insertBefore(sentinel, filterBar);
      const obs = new IntersectionObserver(
        ([entry]) => {
          filterBar.classList.toggle('stuck', !entry.isIntersecting);
        },
        { rootMargin: '-1px 0px 0px 0px', threshold: [1] },
      );
      obs.observe(sentinel);
    }
  </script>

  <style>
    .catalog {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-2xl);
    }
    .catalog-head {
      margin-bottom: var(--space-lg);
    }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-ink-soft);
      margin-bottom: var(--space-sm);
    }
    .lede {
      font-size: 1.1rem;
      color: var(--color-ink-soft);
      margin-top: var(--space-md);
      max-width: 65ch;
    }
    .search-row {
      margin-top: var(--space-lg);
    }
    .filters {
      display: flex;
      gap: var(--space-lg);
      flex-wrap: wrap;
      padding: var(--space-md) 0;
      border-top: var(--border-rule);
      border-bottom: var(--border-rule);
      margin-bottom: var(--space-md);
      position: sticky;
      top: 0;
      background: var(--color-paper);
      z-index: 5;
      transition: box-shadow 0.18s ease;
    }
    .filters.stuck {
      box-shadow: 0 4px 12px rgba(26, 26, 26, 0.08);
    }
    @media (max-width: 720px) {
      .filters {
        position: static;
      }
    }
    .filter-group {
      border: none;
      padding: 0;
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      flex-wrap: wrap;
    }
    .filter-group legend {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-ink-soft);
      margin-right: var(--space-sm);
      float: left;
    }
    .filter-buttons {
      display: flex;
      gap: 0.3rem;
      flex-wrap: wrap;
    }
    .filter-btn {
      font: inherit;
      padding: 0.3rem 0.8rem;
      border: 1px solid var(--color-rule);
      border-radius: 999px;
      background: transparent;
      color: var(--color-ink-soft);
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.15s ease;
    }
    .filter-btn:hover {
      border-color: var(--color-ink);
      color: var(--color-ink);
    }
    .filter-btn.active {
      background: var(--color-ink);
      color: var(--color-paper);
      border-color: var(--color-ink);
    }
    .filter-btn:focus-visible {
      outline: 2px solid var(--color-coral);
      outline-offset: 2px;
    }
    .filter-select {
      font: inherit;
      padding: 0.3rem 0.6rem;
      border: 1px solid var(--color-rule);
      border-radius: var(--radius-sm);
      background: var(--color-paper);
      color: var(--color-ink);
    }
    .result-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-md);
      margin-bottom: var(--space-md);
      flex-wrap: wrap;
    }
    .result-count {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--color-ink-soft);
      margin: 0;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-md);
    }
    .no-results {
      padding: var(--space-2xl) var(--space-lg);
      text-align: center;
      border: 1px dashed var(--color-rule);
      border-radius: var(--radius-md);
      background: var(--color-paper-warm);
    }
    .no-results-title {
      font-family: var(--font-display);
      font-size: 1.2rem;
      color: var(--color-ink);
      margin: 0 0 var(--space-sm);
    }
    .no-results-hint {
      color: var(--color-ink-soft);
      font-size: 0.95rem;
      margin: 0;
    }
    .no-results-hint a {
      color: var(--color-coral);
      text-decoration: underline;
    }
  </style>
</BaseLayout>
